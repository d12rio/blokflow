{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "blokflow",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding; the service name must match the worker name.
			// See https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "blokflow"
		}
	],
	"observability": { "enabled": true },
	"vars": {
		// Not secret. The client id, client secret and base URL are set with `wrangler secret put`.
		"STORYBLOK_SPACE_PLUGIN_SLUG": "d12rio@workflow-kanban"
	}
}
