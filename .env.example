# From Storyblok: Organization (or Partner Portal) → Extensions → your Space Plugin → OAuth 2.0 and Pages
STORYBLOK_PLUGIN_CLIENT_IDENTIFIER=""
STORYBLOK_PLUGIN_CLIENT_SECRET=""

# The extension's slug (Extensions → your plugin → General), used to find its space-level settings
STORYBLOK_SPACE_PLUGIN_SLUG="your-org@workflow-kanban"

# The public https:// URL Storyblok loads the plugin from (an ngrok tunnel to port 3124 in development).
# Set the same URL as "Index to your page", and {URL}/api/connect/callback as "Redirection endpoint".
STORYBLOK_PLUGIN_BASE_URL="https://your-subdomain.ngrok-free.app"
